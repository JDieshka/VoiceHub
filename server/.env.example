# Пример конфигурации для продакшн-деплоя
# Скопируйте в .env и измените значения

# ============================================
# СЕРВЕР
# ============================================

# Порт HTTP-сервера
PORT=8080

# Режим работы: signaling | sfu | hybrid
MODE=hybrid

# ============================================
# БАЗА ДАННЫХ
# ============================================

# PostgreSQL connection string
# Формат: postgres://user:password@host:port/database?sslmode=mode
DATABASE_URL=postgres://voicehub:STRONG_PASSWORD_HERE@localhost:5432/voicehub?sslmode=require

# Максимум соединений с БД
MAX_DB_CONNS=25

# Время жизни соединения (минуты)
DB_CONN_MAX_LIFETIME=5

# ============================================
# БЕЗОПАСНОСТЬ
# ============================================

# СЕКРЕТНЫЙ КЛЮЧ ДЛЯ JWT (ОБЯЗАТЕЛЬНО ИЗМЕНИТЕ!)
# Минимум 32 символа, используйте: openssl rand -base64 48
JWT_SECRET=CHANGE_THIS_TO_RANDOM_64_CHAR_STRING_PLEASE_USE_OPENSSL_RAND

# Время жизни access token (часы)
JWT_EXPIRATION_HOURS=24

# Время жизни refresh token (дни)
REFRESH_EXPIRATION_DAYS=7

# ============================================
# CORS (если фронтенд на другом домене)
# ============================================

# Разрешённые origins (через запятую)
ALLOWED_ORIGINS=https://voicehub.example.com,https://www.voicehub.example.com

# ============================================
# TLS/SSL (ОБЯЗАТЕЛЬНО для продакшна)
# ============================================

# Путь к TLS сертификату
TLS_CERT=/etc/letsencrypt/live/voicehub.example.com/fullchain.pem

# Путь к TLS ключу
TLS_KEY=/etc/letsencrypt/live/voicehub.example.com/privkey.pem

# ============================================
# WEBRTC (для работы через интернет)
# ============================================

# STUN серверы (публичные, бесплатные)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN серверы (ОБЯЗАТЕЛЬНО для продакшна!)
# Без TURN многие пользователи не смогут подключиться из-за NAT
# Можно использовать coturn или облачные TURN сервисы
TURN_URL=turn:voicehub.example.com:3478
TURN_USERNAME=voicehub
TURN_PASSWORD=STRONG_TURN_PASSWORD

# ============================================
# ЛОГИРОВАНИЕ
# ============================================

# Уровень логирования: debug | info | warn | error
LOG_LEVEL=info
