# Frontend Environment Variables
# Скопируйте в .env и измените значения

# ============================================
# API ENDPOINTS
# ============================================

# URL Go-сервера (HTTP API)
# Локальная разработка:
VITE_API_URL=http://localhost:8080
# Продакшн:
# VITE_API_URL=https://voicehub.example.com

# URL WebSocket сервера (для сигнализации)
# Локальная разработка:
VITE_WS_URL=ws://localhost:8080/ws
# Продакшн:
# VITE_WS_URL=wss://voicehub.example.com/ws

# URL SFU сервера (для WebRTC через сервер)
# Локальная разработка:
VITE_SFU_URL=ws://localhost:8080/sfu
# Продакшн:
# VITE_SFU_URL=wss://voicehub.example.com/sfu

# ============================================
# TURN SERVER (для работы через интернет)
# ============================================

# TURN сервер URL
# VITE_TURN_URL=turn:voicehub.example.com:3478

# TURN сервер credentials
# VITE_TURN_USERNAME=voicehub
# VITE_TURN_PASSWORD=your_turn_password

# ============================================
# FEATURES
# ============================================

# Включить SFU режим
# VITE_ENABLE_SFU=true

# Включить push-to-talk
# VITE_ENABLE_PTT=true

# Включить трансляцию экрана
# VITE_ENABLE_SCREEN_SHARE=true
