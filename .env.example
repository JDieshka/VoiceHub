# Примеры конфигурации для разных окружений
# Скопируйте нужный блок в .env файл

# ============================================
# ЛОКАЛЬНАЯ РАЗРАБОТКА
# ============================================
# VITE_API_URL=http://localhost:8080
# VITE_WS_URL=ws://localhost:8080/ws

# ============================================
# ПРОДАКШЕН (с доменом)
# ============================================
# VITE_API_URL=https://voicehub.example.com
# VITE_WS_URL=wss://voicehub.example.com/ws

# ============================================
# ПРОДАКШЕН (с IP адресом)
# ============================================
# VITE_API_URL=http://31.77.158.177:8080
# VITE_WS_URL=ws://31.77.158.177:8080/ws

# ============================================
# TURN СЕРВЕР (опционально, для работы через NAT)
# ============================================
# VITE_TURN_URL=turn:your-turn-server.com:3478
# VITE_TURN_USERNAME=your-username
# VITE_TURN_PASSWORD=your-password

# ============================================
# ПРИЛОЖЕНИЕ АВТОМАТИЧЕСКИ ОПРЕДЕЛЯЕТ URL
# ============================================
# Если переменные не указаны, приложение использует:
# 1. Текущий хост (window.location.hostname)
# 2. Текущий протокол (http/https)
# 3. Текущий порт (или 8080 по умолчанию)
#
# Это позволяет развернуть приложение на любом сервере
# без необходимости указывать URL вручную!
